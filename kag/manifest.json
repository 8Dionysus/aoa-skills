{
  "schema_version": "aoa-local-kag-manifest-v1",
  "repo": "aoa-skills",
  "owner_surface": "kag/AGENTS.md",
  "source_surfaces": [
    {
      "repo": "aoa-skills",
      "path": "generated/capability_graph.json",
      "source_class": "skill_source",
      "role": "primary",
      "authority": "derived_readmodel"
    },
    {
      "repo": "aoa-skills",
      "path": "capabilities/README.md",
      "source_class": "skill_source",
      "role": "owner_route",
      "authority": "authored_source"
    },
    {
      "repo": "aoa-skills",
      "path": "skills/README.md",
      "source_class": "skill_source",
      "role": "supporting",
      "authority": "authored_source"
    },
    {
      "repo": "aoa-skills",
      "path": "generated/agent_skill_catalog.min.json",
      "source_class": "skill_source",
      "role": "supporting",
      "authority": "derived_readmodel"
    }
  ],
  "record_classes": [
    "node",
    "edge",
    "index",
    "projection",
    "receipt"
  ],
  "storage_posture": {
    "git_surface": "portable_records",
    "payload_class": "manifest",
    "runtime_route": "source-repo"
  },
  "validation_routes": [
    {
      "route": "scripts/lanes/ci_gate.py --mode source-fast",
      "lane": "source-fast"
    },
    {
      "route": "aoa-kag:scripts/validate_repo_local_kag_family.py",
      "lane": "local-kag"
    }
  ],
  "consumer_routes": [
    "aoa-kag registry and retrieval",
    "abyss-stack federation mirror",
    "aoa-kag MCP capability resources"
  ],
  "owner_return_routes": [
    {
      "repo": "aoa-skills",
      "surface": "capabilities/README.md",
      "route_kind": "authored_meaning"
    },
    {
      "repo": "aoa-skills",
      "surface": "skills/README.md",
      "route_kind": "source_export"
    }
  ]
}
