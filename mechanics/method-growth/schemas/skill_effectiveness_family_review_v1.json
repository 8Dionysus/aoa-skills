{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.example/schemas/skill_effectiveness_family_review_v1.json",
  "title": "AoA skill effectiveness family review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "review_date",
    "reviewed_revision",
    "review_state",
    "authority",
    "source_refs",
    "decision_counts",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "skill_effectiveness_family_review_v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^aoa-family-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "reviewed_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "review_state": {
      "const": "reviewed"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "source_refs": {
      "$ref": "#/$defs/non_empty_repo_refs"
    },
    "decision_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "improve",
        "split",
        "merge",
        "promote",
        "retain",
        "retire"
      ],
      "properties": {
        "improve": {"type": "integer", "minimum": 0},
        "split": {"type": "integer", "minimum": 0},
        "merge": {"type": "integer", "minimum": 0},
        "promote": {"type": "integer", "minimum": 0},
        "retain": {"type": "integer", "minimum": 0},
        "retire": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "repo_ref": {
      "type": "string",
      "minLength": 1
    },
    "repo_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/repo_ref"},
      "uniqueItems": true
    },
    "non_empty_repo_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repo_ref"},
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_authority",
        "promotion_authority",
        "runtime_authority",
        "raw_session_content_included",
        "private_evidence_included",
        "session_memory_role",
        "live_dispatch_role"
      ],
      "properties": {
        "proof_authority": {"const": false},
        "promotion_authority": {"const": false},
        "runtime_authority": {"const": false},
        "raw_session_content_included": {"const": false},
        "private_evidence_included": {"const": false},
        "session_memory_role": {"const": "reviewed_candidate_evidence_only"},
        "live_dispatch_role": {"const": "reviewed_candidate_evidence_only"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_posture",
        "episode_refs",
        "prompt_visibility",
        "selection",
        "load_read",
        "procedure",
        "verification",
        "outcome",
        "mention_signal",
        "cooccurrence_signal",
        "note"
      ],
      "properties": {
        "evidence_posture": {"const": "reviewed_candidate_only"},
        "episode_refs": {"$ref": "#/$defs/non_empty_repo_refs"},
        "prompt_visibility": {
          "enum": ["observed", "not_observed", "not_applicable"]
        },
        "selection": {
          "enum": [
            "exact",
            "manual_recommendation",
            "legitimate_nonactivation",
            "mixed",
            "not_observed",
            "not_applicable"
          ]
        },
        "load_read": {
          "enum": ["full_read", "not_observed", "not_applicable"]
        },
        "procedure": {
          "enum": [
            "followed",
            "legitimate_deflection",
            "mixed",
            "not_observed",
            "not_applicable"
          ]
        },
        "verification": {
          "enum": ["observed", "not_observed", "not_applicable"]
        },
        "outcome": {
          "enum": [
            "completed",
            "legitimate_deflection",
            "contract_match",
            "mixed",
            "not_observed",
            "not_applicable"
          ]
        },
        "mention_signal": {
          "enum": ["observed_non_authoritative", "not_observed"]
        },
        "cooccurrence_signal": {"const": "not_used_as_effectiveness_proof"},
        "note": {"type": "string", "minLength": 12}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "skill_path",
        "scope",
        "source_status",
        "disposition",
        "action_state",
        "rationale",
        "nearest_alternative_rejected",
        "rejection_reason",
        "evidence",
        "action_refs",
        "next_review_condition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "skill_path": {"$ref": "#/$defs/repo_ref"},
        "scope": {"enum": ["core", "risk", "project"]},
        "source_status": {
          "enum": ["scaffold", "linked", "reviewed", "evaluated", "canonical", "deprecated"]
        },
        "disposition": {
          "enum": ["improve", "split", "merge", "promote", "retain", "retire"]
        },
        "action_state": {
          "enum": ["monitor", "pending_owner_gate", "landed", "blocked"]
        },
        "rationale": {"type": "string", "minLength": 24},
        "nearest_alternative_rejected": {
          "enum": ["improve", "split", "merge", "promote", "retain", "retire"]
        },
        "rejection_reason": {"type": "string", "minLength": 24},
        "evidence": {"$ref": "#/$defs/evidence"},
        "action_refs": {"$ref": "#/$defs/repo_refs"},
        "next_review_condition": {"type": "string", "minLength": 24},
        "target_status": {
          "enum": ["linked", "reviewed", "evaluated", "canonical", "deprecated"]
        },
        "proposed_skill_names": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "merge_target": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "replacement_route": {"$ref": "#/$defs/repo_ref"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "promote"}}},
          "then": {
            "required": ["target_status"],
            "properties": {
              "action_state": {"enum": ["pending_owner_gate", "landed", "blocked"]},
              "action_refs": {"minItems": 1}
            }
          },
          "else": {"not": {"required": ["target_status"]}}
        },
        {
          "if": {"properties": {"disposition": {"const": "improve"}}},
          "then": {
            "properties": {
              "action_state": {"enum": ["pending_owner_gate", "landed", "blocked"]},
              "action_refs": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "retain"}}},
          "then": {"properties": {"action_state": {"const": "monitor"}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "split"}}},
          "then": {
            "required": ["proposed_skill_names"],
            "properties": {"action_refs": {"minItems": 1}}
          },
          "else": {"not": {"required": ["proposed_skill_names"]}}
        },
        {
          "if": {"properties": {"disposition": {"const": "merge"}}},
          "then": {
            "required": ["merge_target"],
            "properties": {"action_refs": {"minItems": 1}}
          },
          "else": {"not": {"required": ["merge_target"]}}
        },
        {
          "if": {"properties": {"disposition": {"const": "retire"}}},
          "then": {
            "required": ["replacement_route"],
            "properties": {"action_refs": {"minItems": 1}}
          },
          "else": {"not": {"required": ["replacement_route"]}}
        }
      ]
    }
  }
}
