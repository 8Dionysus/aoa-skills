{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-private-receipt.schema.json",
  "title": "aoa-skills private live skill-dispatch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "cohort", "model", "effort", "source_lock", "caps", "confirmation_token_sha256", "preflight", "private_root", "trials", "pair_outcomes", "stopped_early", "stop_reason", "review", "proof_authority", "promotion_allowed", "raw_bundle_sha256"],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_private_receipt_v1"},
    "run_id": {"type": "string", "pattern": "^run-[0-9a-f]{24}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "cohort": {"enum": ["smoke", "pilot13", "pilot13-returns", "pilot13-skill-returns", "full-collision", "coverage-closure", "full-collision-core-engineering", "full-collision-core-engineering-returns", "full-collision-core-engineering-outcome-returns", "full-collision-safety-overlays", "full-collision-session-growth", "full-collision-session-growth-returns", "full-collision-authority-routing", "full-collision-authority-routing-returns", "full-collision-eval-children", "coverage-closure-core-implicit", "coverage-closure-titan-implicit-a", "coverage-closure-titan-implicit-b", "coverage-closure-root-trajectories", "coverage-closure-structured-core", "coverage-closure-structured-titan"]},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "effort": {"enum": ["low", "medium", "high", "xhigh"]},
    "source_lock": {"$ref": "#/$defs/source_lock"},
    "caps": {"type": "object"},
    "confirmation_token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight": {"type": "object"},
    "private_root": {"type": "string", "minLength": 1},
    "trials": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "object"}},
    "pair_outcomes": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "stopped_early": {"type": "boolean"},
    "stop_reason": {"type": ["string", "null"]},
    "review": {"$ref": "#/$defs/review"},
    "proof_authority": {"const": false},
    "promotion_allowed": {"const": false},
    "raw_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_commit", "git_head_ref", "plan_sha256", "source_snapshot_sha256", "profile_revision", "protocol_revision"],
      "properties": {
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_head_ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol_revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "shadow_skill_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shadow_skill_count": {"type": "integer", "minimum": 0},
        "configured_mcp_server_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configured_mcp_server_count": {"type": "integer", "minimum": 0}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {"enum": ["pending", "reviewed", "rejected", "needs-rerun"]},
        "note": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
