{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aoa-skills skill intelligence registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_intelligence_registry_version",
    "profile",
    "owner_repo",
    "source_of_truth",
    "skills"
  ],
  "properties": {
    "skill_intelligence_registry_version": { "type": "integer", "minimum": 1 },
    "profile": { "type": "string", "const": "skill-intelligence-registry-v1" },
    "owner_repo": { "type": "string", "const": "aoa-skills" },
    "source_of_truth": { "type": "object" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "status",
          "summary",
          "source",
          "policy",
          "runtime",
          "tiny_router",
          "resources",
          "lineage",
          "boundaries",
          "evaluation",
          "graph_refs",
          "install_refs",
          "search_documents"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scope": { "type": "string", "enum": ["core", "project", "risk"] },
          "status": {
            "type": "string",
            "enum": ["scaffold", "linked", "reviewed", "evaluated", "canonical", "deprecated"]
          },
          "summary": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_path",
              "techniques_path",
              "policy_path",
              "content_hash",
              "skill_revision"
            ],
            "properties": {
              "skill_path": { "type": "string", "minLength": 1 },
              "techniques_path": { "type": "string", "minLength": 1 },
              "policy_path": { "type": ["string", "null"] },
              "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "skill_revision": { "type": "string", "minLength": 1 }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invocation_mode",
              "implicit_activation_policy",
              "trust_posture",
              "mutation_surface",
              "requires_manual_invocation",
              "candidate_only",
              "requires_confirmation_seam"
            ],
            "properties": {
              "invocation_mode": {
                "type": "string",
                "enum": ["implicit-friendly", "explicit-preferred", "explicit-only"]
              },
              "implicit_activation_policy": {
                "type": "string",
                "enum": ["invoke", "suggest", "manual"]
              },
              "trust_posture": { "type": "string" },
              "mutation_surface": { "type": "string" },
              "requires_manual_invocation": { "type": "boolean" },
              "candidate_only": { "type": "boolean" },
              "requires_confirmation_seam": { "type": "boolean" }
            }
          },
          "runtime": { "type": "object" },
          "tiny_router": { "type": "object" },
          "resources": { "type": "object" },
          "lineage": { "type": "object" },
          "boundaries": { "type": "object" },
          "evaluation": { "type": "object" },
          "graph_refs": { "type": "object" },
          "install_refs": { "type": "object" },
          "search_documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "doc_id",
                "skill_name",
                "section_role",
                "source_path",
                "source_anchor",
                "text",
                "text_sha256",
                "token_count"
              ],
              "properties": {
                "doc_id": { "type": "string", "minLength": 1 },
                "skill_name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "section_role": { "type": "string", "minLength": 1 },
                "source_path": { "type": "string", "minLength": 1 },
                "source_anchor": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "token_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
