{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-procedure-contracts.schema.json",
  "title": "aoa-skills source-locked live dispatch child-procedure contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivation_boundary", "proof_authority", "contracts"],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_procedure_contracts_v2"},
    "derivation_boundary": {"const": "source_case_route_and_harness_contracts_only"},
    "proof_authority": {"const": false},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/procedure_contract"}
    }
  },
  "$defs": {
    "nullable_boolean": {"type": ["boolean", "null"]},
    "nullable_disposition": {
      "type": ["string", "null"],
      "enum": ["completed", "blocked_missing_input", "deferred_owner_boundary", "not_applicable", null]
    },
    "procedure_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "case_id",
        "scope",
        "expected_selected_child_skill",
        "expected_selected_child_full_read_observed",
        "expected_selected_procedure_disposition",
        "expected_selected_procedure_completion_reported",
        "expected_selected_procedure_deflection_reported",
        "expected_owner_boundary_present",
        "source_refs",
        "rationale"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-v[0-9]+$", "maxLength": 160},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "scope": {"const": "selected_route_procedure_disposition"},
        "expected_selected_child_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "expected_selected_child_full_read_observed": {"$ref": "#/$defs/nullable_boolean"},
        "expected_selected_procedure_disposition": {"$ref": "#/$defs/nullable_disposition"},
        "expected_selected_procedure_completion_reported": {"$ref": "#/$defs/nullable_boolean"},
        "expected_selected_procedure_deflection_reported": {"$ref": "#/$defs/nullable_boolean"},
        "expected_owner_boundary_present": {"$ref": "#/$defs/nullable_boolean"},
        "source_refs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}
        },
        "rationale": {"type": "string", "minLength": 20, "maxLength": 1000}
      }
    }
  }
}
