{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aoa-skills skill frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
