{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.local/schemas/aoa-skills-release-manifest-v5.json",
  "title": "AoA Skills release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_identity",
    "profile",
    "skill_root",
    "skill_count",
    "advertised_skill_count",
    "deferred_skill_count",
    "profile_count",
    "source_files",
    "portable_files",
    "generated_files",
    "artifact_groups",
    "source_file_digests",
    "portable_file_digests",
    "generated_file_digests",
    "skill_bundle_revisions",
    "install_profile_revisions",
    "release_identity"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 5 },
    "artifact_identity": { "$ref": "#/$defs/artifactIdentity" },
    "profile": { "type": "string", "const": "codex-facing-v2" },
    "skill_root": { "type": "string", "const": ".agents/skills" },
    "skill_count": { "type": "integer", "minimum": 0 },
    "advertised_skill_count": { "type": "integer", "minimum": 0 },
    "deferred_skill_count": { "type": "integer", "minimum": 0 },
    "profile_count": { "type": "integer", "minimum": 0 },
    "source_files": { "$ref": "#/$defs/pathList" },
    "portable_files": { "$ref": "#/$defs/pathList" },
    "generated_files": { "$ref": "#/$defs/pathList" },
    "artifact_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "profile", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "files": { "$ref": "#/$defs/pathList" }
        }
      }
    },
    "source_file_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileDigest" }
    },
    "portable_file_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileDigest" }
    },
    "generated_file_digests": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileDigest" }
    },
    "skill_bundle_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "skill_revision", "source_hash", "portable_hash"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "skill_revision": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "portable_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "install_profile_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "skill_count", "skill_names", "profile_revision"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "skill_count": { "type": "integer", "minimum": 0 },
          "skill_names": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "profile_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changelog",
        "releasing_doc",
        "latest_tagged_version",
        "latest_tagged_date",
        "has_unreleased_changes"
      ],
      "properties": {
        "changelog": { "type": "string", "const": "CHANGELOG.md" },
        "releasing_doc": { "type": "string", "const": "mechanics/release-support/docs/RELEASING.md" },
        "latest_tagged_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "latest_tagged_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "has_unreleased_changes": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "surface_state",
        "owner_repo",
        "authority_ref",
        "producer",
        "consumer_expectation",
        "privacy_boundary",
        "content_identity",
        "abi_epoch",
        "contract_version",
        "trust_layer",
        "verification",
        "action"
      ],
      "properties": {
        "artifact_class": { "type": "string", "const": "aoa_skills_release_manifest" },
        "surface_state": { "type": "string", "const": "generated_portable_skill_export_release_contract" },
        "owner_repo": { "type": "string", "const": "aoa-skills" },
        "authority_ref": { "type": "string", "const": "mechanics/release-support/docs/CODEX_PORTABLE_LAYER.md" },
        "producer": { "type": "string", "minLength": 3 },
        "consumer_expectation": { "type": "string", "minLength": 3 },
        "privacy_boundary": { "type": "string", "minLength": 3 },
        "content_identity": { "type": "string", "minLength": 3 },
        "abi_epoch": { "type": "string", "const": "aoa_skills_release_manifest_v1" },
        "contract_version": { "type": "string", "minLength": 3 },
        "trust_layer": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "action": { "type": "string", "minLength": 3 }
      }
    }
  }
}
