{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/aoa-skills/schemas/skill-home-port.schema.json",
  "title": "AoA repository skill home port",
  "oneOf": [
    {
      "$ref": "#/$defs/repositoryProjectionV1"
    },
    {
      "$ref": "#/$defs/osUserExposureV2"
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "version",
        "lifecycle",
        "visibility",
        "admission_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "lifecycle": {
          "const": "admitted"
        },
        "visibility": {
          "const": "advertised"
        },
        "admission_ref": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "repositoryProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_ref",
        "owner_repo",
        "owner_ref",
        "bundles",
        "projection"
      ],
      "properties": {
        "schema_version": {
          "const": "aoa_skill_home_port_v1"
        },
        "contract_ref": {
          "const": "aoa-skills:schemas/skill-home-port.schema.json"
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owner_ref": {
          "$ref": "#/$defs/relativePath"
        },
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundle"
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "scope",
            "root",
            "mode",
            "skills"
          ],
          "properties": {
            "runtime": {
              "const": "codex"
            },
            "scope": {
              "const": "repo"
            },
            "root": {
              "const": ".agents/skills"
            },
            "mode": {
              "const": "generated-copy"
            },
            "skills": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "osUserExposureV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_ref",
        "owner_repo",
        "owner_ref",
        "bundles",
        "exposure"
      ],
      "properties": {
        "schema_version": {
          "const": "aoa_skill_home_port_v2"
        },
        "contract_ref": {
          "const": "aoa-skills:schemas/skill-home-port.schema.json"
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owner_ref": {
          "$ref": "#/$defs/relativePath"
        },
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundle"
          }
        },
        "exposure": {
          "description": "Declares bundles eligible for the named OS profile route; current membership remains selected by config/os_skill_profiles.json.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "scope",
            "profile",
            "mode",
            "skills"
          ],
          "properties": {
            "runtime": {
              "const": "codex"
            },
            "scope": {
              "const": "user"
            },
            "profile": {
              "description": "Target profile for which these admitted bundles are eligible, not proof of current membership.",
              "const": "os-user-default"
            },
            "mode": {
              "description": "Legacy route label retained for v2 compatibility; it does not assert current profile selection.",
              "const": "profile-selected"
            },
            "skills": {
              "description": "Admitted owner bundles eligible for the declared profile route.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    }
  }
}
