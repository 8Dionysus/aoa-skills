{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-public-receipt.schema.json",
  "title": "aoa-skills public-safe live skill-dispatch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_digest", "created_at", "cohort", "model", "effort",
    "source_lock", "caps", "platform", "trial_count", "measures", "pair_count",
    "pair_outcomes", "failure_counts", "raw_bundle_sha256", "raw_bundle_local_available",
    "review", "stopped_early", "stop_reason", "proof_authority", "promotion_allowed",
    "aggregate_score"
  ],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_public_receipt_v1"},
    "run_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "cohort": {"enum": ["smoke", "pilot13", "pilot13-returns", "pilot13-skill-returns", "full-collision", "coverage-closure", "full-collision-core-engineering", "full-collision-core-engineering-returns", "full-collision-core-engineering-outcome-returns", "full-collision-safety-overlays", "full-collision-session-growth", "full-collision-authority-routing", "full-collision-eval-children", "coverage-closure-core-implicit", "coverage-closure-titan-implicit-a", "coverage-closure-titan-implicit-b", "coverage-closure-root-trajectories", "coverage-closure-structured-core", "coverage-closure-structured-titan"]},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "effort": {"enum": ["low", "medium", "high", "xhigh"]},
    "source_lock": {"$ref": "#/$defs/source_lock"},
    "caps": {"$ref": "#/$defs/caps"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "private_transport"],
      "properties": {
        "identity": {"const": "redacted-local-codex"},
        "private_transport": {"const": true}
      }
    },
    "trial_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "measures": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/measure"}},
    "pair_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "pair_outcomes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/pair"}},
    "failure_counts": {"$ref": "#/$defs/failure_counts"},
    "raw_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "raw_bundle_local_available": {"type": "boolean"},
    "review": {"$ref": "#/$defs/public_review"},
    "stopped_early": {"type": "boolean"},
    "stop_reason": {"anyOf": [{"$ref": "#/$defs/failure_class"}, {"type": "null"}]},
    "proof_authority": {"const": false},
    "promotion_allowed": {"const": false},
    "aggregate_score": {"type": "null"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_commit", "git_head_ref", "plan_sha256", "source_snapshot_sha256", "profile_revision", "protocol_revision"],
      "properties": {
        "head_commit": {"$ref": "#/$defs/sha256"},
        "git_head_ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "profile_revision": {"$ref": "#/$defs/sha256"},
        "protocol_revision": {"type": "string", "minLength": 8, "maxLength": 160},
        "shadow_skill_set_sha256": {"$ref": "#/$defs/sha256"},
        "shadow_skill_count": {"type": "integer", "minimum": 0},
        "configured_mcp_server_set_sha256": {"$ref": "#/$defs/sha256"},
        "configured_mcp_server_count": {"type": "integer", "minimum": 0}
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "per_turn_weighted_token_limit", "per_turn_timeout_seconds", "full_turn_timeout_seconds", "max_transport_retries_before_turn_start", "stop_after_first_safety_violation", "raw_private_only"],
      "properties": {
        "max_concurrency": {"const": 1},
        "per_turn_weighted_token_limit": {"type": "integer", "minimum": 1000, "maximum": 56000},
        "trajectory_weighted_token_limit": {"type": "integer", "minimum": 28000, "maximum": 56000},
        "rollout_budget_reminder_at_remaining_tokens": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1000, "maximum": 27000}},
        "per_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 180},
        "full_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 240},
        "max_transport_retries_before_turn_start": {"const": 0},
        "stop_after_first_safety_violation": {"const": true},
        "raw_private_only": {"const": true}
      }
    },
    "failure_class": {
      "enum": ["harness_contamination", "implicit_trigger_miss", "collision_misroute", "manual_activation_leak", "trajectory_break", "dispatch_policy_gap", "selection_report_miss", "fixture_inventory_scope_violation", "skill_load_gap", "direct_procedure_gap", "fixture_execution_gap", "bounded_outcome_miss", "procedure_disposition_miss", "owner_boundary_violation", "runtime_profile_drift", "budget_exhausted", "output_contract_invalid", "transport_failure"]
    },
    "adaptive_return_route": {
      "enum": ["repair_harness_then_repeat_smoke", "repair_description_policy_then_repeat_adjacent_family", "repair_collision_family_then_repeat_adjacent_family", "repair_manual_policy_then_repeat_smoke", "repair_root_or_child_then_repeat_adjacent_family", "repair_dispatch_policy_then_repeat_same_case", "review_selection_report_contract_then_repeat_same_case", "repair_fixture_inventory_scope_then_repeat_same_case", "repair_read_tooling_or_skill_load_then_repeat_same_case", "repair_child_procedure_then_repeat_direct_arm", "repair_fixture_execution_then_repeat_same_case", "review_skill_procedure_or_outcome_contract_then_repeat_same_case", "review_selected_procedure_or_contract_then_repeat_same_case", "repair_owner_boundary_then_repeat_smoke", "refresh_profile_and_source_lock_then_repeat_smoke", "review_caps_or_reduce_context_then_repeat_same_case", "repair_output_schema_or_prompt_then_repeat_same_case", "repair_transport_then_repeat_same_case_once"]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "arm_type", "expected_target_skill", "expected_behavior", "selected_target_exact", "route_decision", "manual_recommendation", "model_claims_loaded", "structured_skill_visible", "structured_skill_input_sent", "child_full_read_observed", "route_contract_match", "owner_boundary_present", "input_tokens", "cached_input_tokens", "output_tokens", "duration_ms", "transport_returncode", "failure_class", "adaptive_return_route"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "arm_type": {"enum": ["implicit_aided", "implicit_control", "root_manual_child", "app_server_structured"]},
        "expected_target_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "expected_behavior": {"enum": ["invoke", "manual", "explicit", "trajectory"]},
        "selected_target_exact": {"type": "boolean"},
        "reported_target_direct_exact": {"type": "boolean"},
        "reported_target_hierarchy_exact": {"type": "boolean"},
        "hierarchy_report_expected_root_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "hierarchy_report_expected_child_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "selection_report_contract_match": {"type": "boolean"},
        "route_decision": {"type": ["string", "null"], "enum": ["invoke", "manual_required", "do_not_use", null]},
        "manual_recommendation": {"type": "boolean"},
        "model_claims_loaded": {"type": "boolean"},
        "reported_selected_skill_repo_visible": {"type": "boolean"},
        "reported_non_treatment_skill": {"type": "boolean"},
        "structured_skill_visible": {"type": "boolean"},
        "structured_skill_input_sent": {"type": "boolean"},
        "native_target_skill_input_accepted": {"type": "boolean"},
        "child_full_read_observed": {"type": "boolean"},
        "route_contract_match": {"type": "boolean"},
        "prompt_visibility_contract_match": {"type": "boolean"},
        "fixture_filesystem_scope_match": {"type": "boolean"},
        "external_filesystem_access_count": {"type": "integer", "minimum": 0},
        "fixture_inventory_scope_match": {"type": "boolean"},
        "broad_fixture_inventory_command_count": {"type": "integer", "minimum": 0},
        "prompt_visible_repo_skill_count": {"type": "integer", "minimum": 0},
        "expected_prompt_visible_repo_skill_count": {"type": "integer", "minimum": 0},
        "structured_skill_surface_contract_match": {"type": ["boolean", "null"]},
        "external_runtime_isolation_match": {"type": ["boolean", "null"]},
        "selected_child_exact": {"type": "boolean"},
        "dispatch_contract_match": {"type": "boolean"},
        "load_contract_match": {"type": "boolean"},
        "target_skill_full_read_observed": {"type": "boolean"},
        "procedure_disposition": {"anyOf": [{"$ref": "#/$defs/procedure_disposition"}, {"type": "null"}]},
        "procedure_command_observed": {"type": "boolean"},
        "procedure_command_succeeded": {"type": "boolean"},
        "verification_observed": {"type": "boolean"},
        "procedure_contract_match": {"type": "boolean"},
        "fixture_command_observed": {"type": "boolean"},
        "fixture_command_succeeded": {"type": "boolean"},
        "fixture_verification_observed": {"type": "boolean"},
        "fixture_execution_contract_match": {"type": "boolean"},
        "completion_observed": {"type": "boolean"},
        "deflection_observed": {"type": "boolean"},
        "selected_procedure_completion_reported": {"type": "boolean"},
        "selected_procedure_deflection_reported": {"type": "boolean"},
        "trajectory_contract_defined": {"type": "boolean"},
        "trajectory_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "trajectory_expected_child_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "trajectory_contract_match": {"type": ["boolean", "null"]},
        "trajectory_mismatch_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {"enum": ["selected_child_skill", "selected_child_full_read_observed"]}
        },
        "procedure_contract_defined": {"type": "boolean"},
        "procedure_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "procedure_contract_scope": {"type": ["string", "null"], "enum": ["selected_route_procedure_disposition", null]},
        "procedure_contract": {"anyOf": [{"$ref": "#/$defs/procedure_expectation"}, {"type": "null"}]},
        "procedure_disposition_contract_match": {"type": ["boolean", "null"]},
        "procedure_disposition_mismatch_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {"enum": ["selected_procedure_disposition", "selected_procedure_completion_reported", "selected_procedure_deflection_reported", "owner_boundary_present"]}
        },
        "outcome_contract_defined": {"type": "boolean"},
        "outcome_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "outcome_scope": {"type": ["string", "null"], "enum": ["bounded_fixture_outcome", "bounded_downstream_procedure_outcome", "fixture_owner_observable_decision", null]},
        "outcome_contract": {"anyOf": [{"$ref": "#/$defs/outcome_expectation"}, {"$ref": "#/$defs/owner_observable_outcome_expectation"}, {"type": "null"}]},
        "outcome_contract_match": {"type": ["boolean", "null"]},
        "outcome_command_observed": {"type": "boolean"},
        "outcome_single_attempt": {"type": "boolean"},
        "outcome_command_succeeded": {"type": "boolean"},
        "outcome_verification_observed": {"type": "boolean"},
        "outcome_validator_not_inspected": {"type": "boolean"},
        "outcome_output_observation_gap": {"type": "boolean"},
        "outcome_mismatch_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "enum": ["procedure_disposition", "procedure_command_observed", "procedure_command_succeeded", "verification_observed", "completion_observed", "deflection_observed", "owner_boundary_present", "outcome_command_observed", "outcome_single_attempt", "outcome_command_succeeded", "outcome_verification_observed", "outcome_validator_not_inspected"]
          }
        },
        "owner_boundary_present": {"type": "boolean"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "transport_returncode": {"type": "integer", "minimum": -255, "maximum": 255},
        "failure_class": {"anyOf": [{"$ref": "#/$defs/failure_class"}, {"type": "null"}]},
        "adaptive_return_route": {"anyOf": [{"$ref": "#/$defs/adaptive_return_route"}, {"type": "null"}]}
      }
    },
    "outcome_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "scope", "contract_sha256", "expected_procedure_disposition", "expected_procedure_command_observed", "expected_procedure_command_succeeded", "expected_verification_observed", "expected_completion_observed", "expected_deflection_observed", "expected_owner_boundary_present"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-v[0-9]+$", "maxLength": 160},
        "scope": {"enum": ["bounded_fixture_outcome", "bounded_downstream_procedure_outcome"]},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "expected_procedure_disposition": {"anyOf": [{"$ref": "#/$defs/procedure_disposition"}, {"type": "null"}]},
        "expected_procedure_command_observed": {"type": ["boolean", "null"]},
        "expected_procedure_command_succeeded": {"type": ["boolean", "null"]},
        "expected_verification_observed": {"type": ["boolean", "null"]},
        "expected_completion_observed": {"type": ["boolean", "null"]},
        "expected_deflection_observed": {"type": ["boolean", "null"]},
        "expected_owner_boundary_present": {"type": ["boolean", "null"]}
      }
    },
    "owner_observable_outcome_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "scope", "contract_sha256", "candidate_set_sha256", "expected_outcome_command_observed", "expected_outcome_single_attempt", "expected_outcome_command_succeeded", "expected_outcome_verification_observed", "expected_outcome_validator_not_inspected"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-v[0-9]+$", "maxLength": 160},
        "scope": {"const": "fixture_owner_observable_decision"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
        "expected_outcome_command_observed": {"const": true},
        "expected_outcome_single_attempt": {"const": true},
        "expected_outcome_command_succeeded": {"const": true},
        "expected_outcome_verification_observed": {"const": true},
        "expected_outcome_validator_not_inspected": {"const": true}
      }
    },
    "procedure_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "scope", "contract_sha256", "expected_selected_child_skill", "expected_selected_child_full_read_observed", "expected_selected_procedure_disposition", "expected_selected_procedure_completion_reported", "expected_selected_procedure_deflection_reported", "expected_owner_boundary_present"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-v[0-9]+$", "maxLength": 160},
        "scope": {"const": "selected_route_procedure_disposition"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "expected_selected_child_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "expected_selected_child_full_read_observed": {"type": ["boolean", "null"]},
        "expected_selected_procedure_disposition": {"anyOf": [{"$ref": "#/$defs/procedure_disposition"}, {"type": "null"}]},
        "expected_selected_procedure_completion_reported": {"type": ["boolean", "null"]},
        "expected_selected_procedure_deflection_reported": {"type": ["boolean", "null"]},
        "expected_owner_boundary_present": {"type": ["boolean", "null"]}
      }
    },
    "pair": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_pair"},
        {"$ref": "#/$defs/route_outcome_pair"}
      ]
    },
    "legacy_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_target_skill", "expected_behavior", "aided_route_contract_match", "control_route_contract_match", "observed_lift", "effect_class", "fixture_context_match", "input_token_delta", "duration_ms_delta"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "expected_target_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "expected_behavior": {"enum": ["invoke", "manual"]},
        "aided_route_contract_match": {"type": "boolean"},
        "control_route_contract_match": {"type": "boolean"},
        "observed_lift": {"type": "integer", "minimum": -1, "maximum": 1},
        "effect_class": {"enum": ["positive_lift", "negative_lift", "no_lift_both_correct", "no_lift_both_incorrect", "contaminated"]},
        "fixture_context_match": {"type": "boolean"},
        "prompt_background_match": {"type": "boolean"},
        "prompt_visibility_contract_match": {"type": "boolean"},
        "aided_dispatch_contract_match": {"type": "boolean"},
        "control_dispatch_contract_match": {"type": "boolean"},
        "aided_load_contract_match": {"type": "boolean"},
        "control_load_contract_match": {"type": "boolean"},
        "input_token_delta": {"type": "integer"},
        "duration_ms_delta": {"type": "integer"}
      }
    },
    "route_outcome_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expected_target_skill", "expected_behavior", "aided_route_contract_match", "control_route_contract_match", "route_lift", "route_effect_class", "outcome_contract_defined", "outcome_contract_consistent", "outcome_contract_sha256", "aided_outcome_contract_match", "control_outcome_contract_match", "outcome_lift", "outcome_effect_class", "fixture_context_match", "prompt_background_match", "prompt_visibility_contract_match", "aided_dispatch_contract_match", "control_dispatch_contract_match", "aided_load_contract_match", "control_load_contract_match", "input_token_delta", "duration_ms_delta"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "expected_target_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "expected_behavior": {"enum": ["invoke", "manual"]},
        "aided_route_contract_match": {"type": "boolean"},
        "control_route_contract_match": {"type": "boolean"},
        "route_lift": {"type": ["integer", "null"], "minimum": -1, "maximum": 1},
        "route_effect_class": {"enum": ["positive_lift", "negative_lift", "no_lift_both_correct", "no_lift_both_incorrect", "contaminated"]},
        "trajectory_contract_defined": {"type": "boolean"},
        "trajectory_contract_consistent": {"type": "boolean"},
        "trajectory_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "trajectory_expected_child_skill": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
        "aided_trajectory_contract_match": {"type": ["boolean", "null"]},
        "control_trajectory_contract_match": {"type": ["boolean", "null"]},
        "trajectory_lift": {"type": ["integer", "null"], "minimum": -1, "maximum": 1},
        "trajectory_effect_class": {"enum": ["positive_lift", "negative_lift", "no_lift_both_correct", "no_lift_both_incorrect", "contaminated", "not_scored_no_contract"]},
        "procedure_contract_defined": {"type": "boolean"},
        "procedure_contract_consistent": {"type": "boolean"},
        "procedure_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "procedure_contract_scope": {"type": ["string", "null"], "enum": ["selected_route_procedure_disposition", null]},
        "aided_procedure_disposition_contract_match": {"type": ["boolean", "null"]},
        "control_procedure_disposition_contract_match": {"type": ["boolean", "null"]},
        "procedure_disposition_lift": {"type": ["integer", "null"], "minimum": -1, "maximum": 1},
        "procedure_disposition_effect_class": {"enum": ["positive_lift", "negative_lift", "no_lift_both_correct", "no_lift_both_incorrect", "contaminated", "not_scored_no_contract"]},
        "outcome_contract_defined": {"type": "boolean"},
        "outcome_contract_consistent": {"type": "boolean"},
        "outcome_contract_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "outcome_scope": {"type": ["string", "null"], "enum": ["bounded_fixture_outcome", "bounded_downstream_procedure_outcome", "fixture_owner_observable_decision", null]},
        "aided_outcome_contract_match": {"type": ["boolean", "null"]},
        "control_outcome_contract_match": {"type": ["boolean", "null"]},
        "outcome_lift": {"type": ["integer", "null"], "minimum": -1, "maximum": 1},
        "outcome_effect_class": {"enum": ["positive_lift", "negative_lift", "no_lift_both_correct", "no_lift_both_incorrect", "contaminated", "not_scored_no_contract", "not_scored_no_observable_outcome"]},
        "aided_outcome_output_observation_gap": {"type": "boolean"},
        "control_outcome_output_observation_gap": {"type": "boolean"},
        "outcome_output_observation_gap_effect_class": {"enum": ["none", "aided_only", "control_only", "both"]},
        "outcome_lift_observation_clean": {"type": ["boolean", "null"]},
        "fixture_context_match": {"type": "boolean"},
        "prompt_background_match": {"type": "boolean"},
        "prompt_visibility_contract_match": {"type": "boolean"},
        "aided_dispatch_contract_match": {"type": "boolean"},
        "control_dispatch_contract_match": {"type": "boolean"},
        "aided_load_contract_match": {"type": "boolean"},
        "control_load_contract_match": {"type": "boolean"},
        "aided_fixture_execution_contract_match": {"type": "boolean"},
        "control_fixture_execution_contract_match": {"type": "boolean"},
        "input_token_delta": {"type": "integer"},
        "duration_ms_delta": {"type": "integer"}
      }
    },
    "failure_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness_contamination": {"type": "integer", "minimum": 1},
        "implicit_trigger_miss": {"type": "integer", "minimum": 1},
        "collision_misroute": {"type": "integer", "minimum": 1},
        "manual_activation_leak": {"type": "integer", "minimum": 1},
        "trajectory_break": {"type": "integer", "minimum": 1},
        "dispatch_policy_gap": {"type": "integer", "minimum": 1},
        "selection_report_miss": {"type": "integer", "minimum": 1},
        "fixture_inventory_scope_violation": {"type": "integer", "minimum": 1},
        "skill_load_gap": {"type": "integer", "minimum": 1},
        "direct_procedure_gap": {"type": "integer", "minimum": 1},
        "fixture_execution_gap": {"type": "integer", "minimum": 1},
        "bounded_outcome_miss": {"type": "integer", "minimum": 1},
        "procedure_disposition_miss": {"type": "integer", "minimum": 1},
        "owner_boundary_violation": {"type": "integer", "minimum": 1},
        "runtime_profile_drift": {"type": "integer", "minimum": 1},
        "budget_exhausted": {"type": "integer", "minimum": 1},
        "output_contract_invalid": {"type": "integer", "minimum": 1},
        "transport_failure": {"type": "integer", "minimum": 1}
      }
    },
    "procedure_disposition": {
      "type": "string",
      "enum": ["completed", "blocked_missing_input", "deferred_owner_boundary", "not_applicable"]
