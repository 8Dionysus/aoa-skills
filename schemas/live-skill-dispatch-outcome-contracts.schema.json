{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-outcome-contracts.schema.json",
  "title": "aoa-skills source-locked live dispatch owner-observable outcome contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivation_boundary", "proof_authority", "contracts"],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_outcome_contracts_v1"},
    "derivation_boundary": {"const": "source_case_skill_and_fixture_owner_action_only"},
    "proof_authority": {"const": false},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/outcome_contract"}
    }
  },
  "$defs": {
    "candidate_value": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]+$",
      "minLength": 3,
      "maxLength": 100
    },
    "outcome_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "case_id",
        "scope",
        "decision_prompt",
        "candidate_values",
        "expected_candidate_value",
        "source_refs",
        "rationale"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-v[0-9]+$", "maxLength": 160},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "scope": {"const": "fixture_owner_observable_decision"},
        "decision_prompt": {"type": "string", "minLength": 20, "maxLength": 300},
        "candidate_values": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidate_value"}
        },
        "expected_candidate_value": {"$ref": "#/$defs/candidate_value"},
        "source_refs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}
        },
        "rationale": {"type": "string", "minLength": 40, "maxLength": 1200}
      }
    }
  }
}
