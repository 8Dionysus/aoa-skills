{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-plan.schema.json",
  "title": "aoa-skills live skill dispatch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_repo",
    "profile",
    "profile_revision",
    "protocol_revision",
    "proof_authority",
    "promotion_allowed",
    "default_action",
    "source_refs",
    "sources",
    "caps",
    "cohorts",
    "root_child_trajectories",
    "failure_taxonomy",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_plan_v1"},
    "owner_repo": {"const": "aoa-skills"},
    "profile": {"const": "repo-default"},
    "profile_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_revision": {"type": "string", "minLength": 8, "maxLength": 160},
    "proof_authority": {"const": false},
    "promotion_allowed": {"const": false},
    "default_action": {"const": "plan"},
    "source_refs": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collision_matrix", "description_cases", "skill_catalog", "policy_matrix", "pack_profiles", "protocol_contract"],
      "properties": {
        "collision_matrix": {"type": "string"},
        "description_cases": {"type": "string"},
        "skill_catalog": {"type": "string"},
        "policy_matrix": {"type": "string"},
        "pack_profiles": {"type": "string"},
        "protocol_contract": {"const": "evals/suites/codex-app-server-skill-input.contract.json"}
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "per_turn_weighted_token_limit", "trajectory_weighted_token_limit", "rollout_budget_reminder_at_remaining_tokens", "per_turn_timeout_seconds", "full_turn_timeout_seconds", "max_transport_retries_before_turn_start", "stop_after_first_safety_violation", "raw_private_only"],
      "properties": {
        "max_concurrency": {"const": 1},
        "per_turn_weighted_token_limit": {"type": "integer", "minimum": 1000, "maximum": 28000},
        "trajectory_weighted_token_limit": {"type": "integer", "minimum": 28000, "maximum": 56000},
        "rollout_budget_reminder_at_remaining_tokens": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1000, "maximum": 27000}},
        "per_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 180},
        "full_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 240},
        "max_transport_retries_before_turn_start": {"const": 0},
        "stop_after_first_safety_violation": {"const": true},
        "raw_private_only": {"const": true}
      }
    },
    "cohorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "pilot13", "full-collision", "coverage-closure"],
      "properties": {
        "smoke": {"$ref": "#/$defs/cohort"},
        "pilot13": {"$ref": "#/$defs/cohort"},
        "full-collision": {"$ref": "#/$defs/cohort"},
        "coverage-closure": {"$ref": "#/$defs/cohort"}
      }
    },
    "root_child_trajectories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "root_skill", "child_skill"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^collision-[0-9]{2}$"},
          "root_skill": {"enum": ["aoa-decision", "aoa-eval"]},
          "child_skill": {"type": "string", "pattern": "^aoa-[a-z0-9-]+$"}
        }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_root", "directory_mode", "file_mode", "public_raw_text_allowed", "public_absolute_paths_allowed", "public_transport_ids_allowed"],
      "properties": {
        "private_root": {"const": "/srv/abyss-machine/tmp/ai/aoa-skill-live-evals"},
        "directory_mode": {"const": "0700"},
        "file_mode": {"const": "0600"},
        "public_raw_text_allowed": {"const": false},
        "public_absolute_paths_allowed": {"const": false},
        "public_transport_ids_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implicit_case_ids", "trajectory_case_ids", "structured_skills", "expected_turn_count", "estimated_private_bytes", "estimated_memory_demand_mib", "resource_class"],
      "properties": {
        "implicit_case_ids": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            {"enum": ["all-collision-cases", "all-uncovered-skills"]}
          ]
        },
        "trajectory_case_ids": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            {"const": "all-root-child-trajectories"}
          ]
        },
        "structured_skills": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}},
            {"const": "all-non-invoke-skills"}
          ]
        },
        "expected_turn_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "estimated_private_bytes": {"type": "integer", "minimum": 1048576, "maximum": 2147483648},
        "estimated_memory_demand_mib": {"type": "integer", "minimum": 128, "maximum": 2048},
        "resource_class": {"enum": ["light", "medium", "sustained"]}
      }
    }
  }
}
