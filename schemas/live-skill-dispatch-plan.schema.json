{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-plan.schema.json",
  "title": "aoa-skills live skill dispatch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_repo",
    "profile",
    "profile_revision",
    "protocol_revision",
    "proof_authority",
    "promotion_allowed",
    "default_action",
    "source_refs",
    "sources",
    "caps",
    "cohorts",
    "cohort_partitions",
    "root_child_trajectories",
    "structured_report_child_hierarchies",
    "failure_taxonomy",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": "aoa_skill_live_dispatch_plan_v1"},
    "owner_repo": {"const": "aoa-skills"},
    "profile": {"const": "repo-default"},
    "profile_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_revision": {"type": "string", "minLength": 8, "maxLength": 160},
    "proof_authority": {"const": false},
    "promotion_allowed": {"const": false},
    "default_action": {"const": "plan"},
    "source_refs": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collision_matrix", "description_cases", "skill_catalog", "policy_matrix", "pack_profiles", "protocol_contract", "procedure_contracts", "outcome_contracts"],
      "properties": {
        "collision_matrix": {"type": "string"},
        "description_cases": {"type": "string"},
        "skill_catalog": {"type": "string"},
        "policy_matrix": {"type": "string"},
        "pack_profiles": {"type": "string"},
        "protocol_contract": {"const": "evals/suites/codex-app-server-skill-input.contract.json"},
        "procedure_contracts": {"const": "evals/suites/aoa-skill-live-dispatch-procedures.json"},
        "outcome_contracts": {"const": "evals/suites/aoa-skill-live-dispatch-outcomes.json"}
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "per_turn_weighted_token_limit", "trajectory_weighted_token_limit", "rollout_budget_reminder_at_remaining_tokens", "per_turn_timeout_seconds", "full_turn_timeout_seconds", "max_transport_retries_before_turn_start", "stop_after_first_safety_violation", "raw_private_only"],
      "properties": {
        "max_concurrency": {"const": 1},
        "per_turn_weighted_token_limit": {"type": "integer", "minimum": 1000, "maximum": 56000},
        "trajectory_weighted_token_limit": {"type": "integer", "minimum": 28000, "maximum": 56000},
        "rollout_budget_reminder_at_remaining_tokens": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1000, "maximum": 27000}},
        "per_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 180},
        "full_turn_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 240},
        "max_transport_retries_before_turn_start": {"const": 0},
        "stop_after_first_safety_violation": {"const": true},
        "raw_private_only": {"const": true}
      }
    },
    "cohorts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smoke",
        "pilot13",
        "pilot13-returns",
        "pilot13-skill-returns",
        "full-collision",
        "coverage-closure",
        "full-collision-core-engineering",
        "full-collision-core-engineering-returns",
        "full-collision-core-engineering-outcome-returns",
        "full-collision-safety-overlays",
        "full-collision-session-growth",
        "full-collision-session-growth-returns",
        "full-collision-authority-routing",
        "full-collision-authority-routing-returns",
        "full-collision-authority-routing-procedure-returns",
        "full-collision-eval-children",
        "coverage-closure-core-implicit",
        "coverage-closure-titan-implicit-a",
        "coverage-closure-titan-implicit-b",
        "coverage-closure-titan-implicit-b-returns",
        "coverage-closure-root-trajectories",
        "coverage-closure-structured-core",
        "coverage-closure-structured-core-returns",
        "coverage-closure-structured-titan"
      ],
      "properties": {
        "smoke": {"$ref": "#/$defs/cohort"},
        "pilot13": {"$ref": "#/$defs/cohort"},
        "pilot13-returns": {"$ref": "#/$defs/cohort"},
        "pilot13-skill-returns": {"$ref": "#/$defs/cohort"},
        "full-collision": {"$ref": "#/$defs/cohort"},
        "coverage-closure": {"$ref": "#/$defs/cohort"},
        "full-collision-core-engineering": {"$ref": "#/$defs/cohort"},
        "full-collision-core-engineering-returns": {"$ref": "#/$defs/cohort"},
        "full-collision-core-engineering-outcome-returns": {"$ref": "#/$defs/cohort"},
        "full-collision-safety-overlays": {"$ref": "#/$defs/cohort"},
        "full-collision-session-growth": {"$ref": "#/$defs/cohort"},
        "full-collision-session-growth-returns": {"$ref": "#/$defs/cohort"},
        "full-collision-authority-routing": {"$ref": "#/$defs/cohort"},
        "full-collision-authority-routing-returns": {"$ref": "#/$defs/cohort"},
        "full-collision-authority-routing-procedure-returns": {"$ref": "#/$defs/cohort"},
        "full-collision-eval-children": {"$ref": "#/$defs/cohort"},
        "coverage-closure-core-implicit": {"$ref": "#/$defs/cohort"},
        "coverage-closure-titan-implicit-a": {"$ref": "#/$defs/cohort"},
        "coverage-closure-titan-implicit-b": {"$ref": "#/$defs/cohort"},
        "coverage-closure-titan-implicit-b-returns": {"$ref": "#/$defs/cohort"},
        "coverage-closure-root-trajectories": {"$ref": "#/$defs/cohort"},
        "coverage-closure-structured-core": {"$ref": "#/$defs/cohort"},
        "coverage-closure-structured-core-returns": {"$ref": "#/$defs/cohort"},
        "coverage-closure-structured-titan": {"$ref": "#/$defs/cohort"}
      }
    },
    "cohort_partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full-collision", "coverage-closure"],
      "properties": {
        "full-collision": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "full-collision-core-engineering",
              "full-collision-safety-overlays",
              "full-collision-session-growth",
              "full-collision-authority-routing",
              "full-collision-eval-children"
            ]
          }
        },
        "coverage-closure": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "coverage-closure-core-implicit",
              "coverage-closure-titan-implicit-a",
              "coverage-closure-titan-implicit-b",
              "coverage-closure-root-trajectories",
              "coverage-closure-structured-core",
              "coverage-closure-structured-titan"
            ]
          }
        }
      }
    },
    "root_child_trajectories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "root_skill", "child_skill"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^collision-[0-9]{2}$"},
          "root_skill": {"enum": ["aoa-decision", "aoa-eval"]},
          "child_skill": {"type": "string", "pattern": "^aoa-[a-z0-9-]+$"}
        }
      }
    },
    "structured_report_child_hierarchies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 57,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_skill", "child_skill"],
        "properties": {
          "target_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120},
          "child_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$", "maxLength": 120}
        }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_root", "directory_mode", "file_mode", "public_raw_text_allowed", "public_absolute_paths_allowed", "public_transport_ids_allowed"],
      "properties": {
        "private_root": {"const": "/srv/abyss-machine/tmp/ai/aoa-skill-live-evals"},
        "directory_mode": {"const": "0700"},
        "file_mode": {"const": "0600"},
        "public_raw_text_allowed": {"const": false},
        "public_absolute_paths_allowed": {"const": false},
        "public_transport_ids_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implicit_case_ids", "trajectory_case_ids", "structured_skills", "procedure_contract_mode", "objective_outcome_mode", "second_confirmation_required", "expected_turn_count", "estimated_private_bytes", "estimated_memory_demand_mib", "resource_class"],
      "properties": {
        "implicit_case_ids": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            {"enum": ["all-collision-cases", "all-uncovered-skills"]}
          ]
        },
        "trajectory_case_ids": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            {"const": "all-root-child-trajectories"}
          ]
        },
        "structured_skills": {
          "oneOf": [
            {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}},
            {"const": "all-non-invoke-skills"}
          ]
        },
        "procedure_contract_mode": {"enum": ["required", "required_for_live", "declared_only"]},
        "objective_outcome_mode": {"enum": ["not_scored_fixture_only", "required", "required_for_live", "declared_only"]},
        "second_confirmation_required": {"type": "boolean"},
        "expected_turn_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "estimated_private_bytes": {"type": "integer", "minimum": 1048576, "maximum": 2147483648},
        "estimated_memory_demand_mib": {"type": "integer", "minimum": 128, "maximum": 2048},
        "resource_class": {"enum": ["light", "medium", "sustained"]}
      }
    }
  }
}
