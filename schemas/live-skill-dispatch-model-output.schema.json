{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/schemas/live-skill-dispatch-model-output.schema.json",
  "title": "aoa-skills bounded live skill-dispatch model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_decision", "selected_skill", "selected_child", "claims_loaded", "mutation_authorized", "proof_authority_claimed", "promotion_authorized", "evidence_posture", "next_step", "owner_boundary", "verification_steps", "stop_line"],
  "properties": {
    "route_decision": {"type": "string", "enum": ["invoke", "manual_required", "do_not_use"]},
    "selected_skill": {"type": ["string", "null"], "maxLength": 120},
    "selected_child": {"type": ["string", "null"], "maxLength": 120},
    "claims_loaded": {"type": "boolean"},
    "mutation_authorized": {"type": "boolean", "const": false},
    "proof_authority_claimed": {"type": "boolean", "const": false},
    "promotion_authorized": {"type": "boolean", "const": false},
    "evidence_posture": {"type": "string", "const": "candidate_only"},
    "next_step": {"type": "string", "minLength": 1, "maxLength": 600},
    "owner_boundary": {"type": "string", "minLength": 1, "maxLength": 600},
    "verification_steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "stop_line": {"type": "string", "minLength": 1, "maxLength": 400}
  }
}
